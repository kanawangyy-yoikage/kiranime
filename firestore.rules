rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USERS ───────────────────────────────────────────────
    // Setiap user cuma bisa baca/tulis doc dirinya sendiri.
    // Search users butuh list/query — izinkan get+list untuk yang sudah login.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Subcollection: history, favorites, watchlist, continue, groups, stickers
      match /{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ─── FRIENDSHIPS ─────────────────────────────────────────
    // Doc dibuat saat kirim/terima permintaan. Yang boleh baca: yang terlibat.
    // Yang boleh tulis: si pengirim (from.uid == auth.uid) saat kirim,
    // atau salah satu dari kedua user saat update status / delete.
    match /friendships/{id} {
      allow read: if request.auth != null
        && (resource.data.from.uid == request.auth.uid
            || resource.data.to.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && (resource.data.from.uid == request.auth.uid
            || resource.data.to.uid == request.auth.uid);
    }

    // ─── GROUPS ──────────────────────────────────────────────
    // Baca: member grup (via memberIds) atau owner. Tulis: owner (update/delete).
    match /groups/{groupId} {
      allow read: if request.auth != null
        && (resource.data.memberIds != null
            && resource.data.memberIds.hasAny([request.auth.uid])
            || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Pesan grup: baca member, tulis member (kirim pesan).
      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds.hasAny([request.auth.uid]);
        allow update, delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }

    // ─── CONVERSATIONS (DM) ──────────────────────────────────
    // Baca/tulis: hanya user yang terlibat (via memberIds).
    match /conversations/{convId} {
      allow read: if request.auth != null
        && resource.data.memberIds != null
        && request.auth.uid in resource.data.memberIds;
      allow write: if request.auth != null
        && request.resource.data.memberIds != null
        && request.auth.uid in request.resource.data.memberIds;

      // Pesan DM: baca/tulis hanya peserta.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow update, delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
